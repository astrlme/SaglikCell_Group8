# ─── PostgreSQL (docker-compose) ───────────────────────────────
# PostgreSQL
POSTGRES_DB=saglikcell
POSTGRES_USER=saglikcell
POSTGRES_PASSWORD=saglikcell
POSTGRES_PORT=5432

# ─── pgAdmin (docker-compose) ──────────────────────────────────
PGADMIN_EMAIL=admin@test.com
PGADMIN_PASSWORD=admin
PGADMIN_PORT=5050

# ─── SaglikCell Backend (docker-compose) ───────────────────────
BACKEND_PORT=5080
ASPNETCORE_ENVIRONMENT=Development

# JWT settings (key MUST be at least 32 characters)
JWT_KEY=super-secret-key-for-saglikcell-demo-please-change-me-32chars
JWT_ISSUER=SaglikCell
JWT_AUDIENCE=SaglikCellUsers
JWT_ACCESS_TOKEN_MINUTES=60
JWT_REFRESH_TOKEN_DAYS=7

# CORS origin (frontend URL)
CORS_ORIGIN=http://localhost:5173

# ─── Local dev (without Docker) ───────────────────────────────
# ASP.NET Core reads these as overrides via AddEnvironmentVariables().
# Use double-underscore (__) for nested configuration keys.
# ASPNETCORE_URLS=http://localhost:5080
# ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=saglikcell;Username=saglikcell;Password=saglikcell
# Jwt__Key=super-secret-key-for-saglikcell-demo-please-change-me-32chars
# Jwt__Issuer=SaglikCell
# Jwt__Audience=SaglikCellUsers
# Jwt__AccessTokenMinutes=60
# Jwt__RefreshTokenDays=7
# Cors__AllowedOrigins__0=http://localhost:5173
